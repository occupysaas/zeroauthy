  "limits": {
    "domains": 100,
    "body_bytes": 65536,
    "metadata_properties": 10,
    "metadata_value_characters": 255,
    "hostname_bytes": 253,
    "label_bytes": 63,
    "query_bytes": 1024,
    "query_terms": 8
  },
  "null_rules": {
    "custom_client_ip_header": "null or empty disables; omitted create defaults x-forwarded-for",
    "domain_metadata": "object string values only; null rejected; empty clears",
    "relying_party_identifier": "omitted create uses domain; null patch clears",
    "required_fields": "null and empty rejected",
    "metadata_keys": "no additional per-key limit; body limit applies"
  },
  "query": {
    "sort": [
      "domain:1"
    ],
    "parameters": [
      "q",
      "fields",
      "include_fields",
      "sort"
    ],
    "q": "exact quoted domain/status/type terms joined with AND; max eight terms / 1024 bytes"
  },
  "capabilities": {
    "active": [
      "domain ownership",
      "TLS >=1.2",
      "client IP",
      "default notification origin",
      "domain_metadata"
    ],
    "stored-only": [
      "relying_party_identifier"
    ],
    "tool-unavailable": [
      "Deploy CLI x-azure-clientip and empty header",
      "Deploy CLI clearing a custom default",
      "ACUL",
      "live upstream observation"
    ]
  },
