{
 "strategy": "instagram",
 "display_name": "Instagram",
 "source": [
  "https://developers.facebook.com/docs/instagram-basic-display-api",
  "https://auth0.com/docs/authenticate/identity-providers/social-identity-providers/instagram"
 ],
 "authorization_url": "https://api.instagram.com/oauth/authorize",
 "token_url": "https://api.instagram.com/oauth/access_token",
 "profile_url": "https://graph.instagram.com/me?fields=id,username",
 "token_auth": "client_secret_post",
 "pkce": "none",
 "base_scopes": [
  "user_profile"
 ],
 "flags": [],
 "freeform_scopes": false,
 "free_scope": true,
 "profile": {
  "user_id": "id",
  "nickname": "username"
 },
 "email_verified": {
  "rule": "never"
 },
 "retired": {
  "date": "2024-12-04",
  "reason": "Meta shut down the Instagram Basic Display API",
  "source": "https://developers.facebook.com/docs/instagram-basic-display-api"
 }
}
