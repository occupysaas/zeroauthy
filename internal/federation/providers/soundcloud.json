{
 "strategy": "soundcloud",
 "display_name": "SoundCloud",
 "source": [
  "https://developers.soundcloud.com/docs/api/guide#authentication",
  "https://auth0.com/docs/authenticate/identity-providers/social-identity-providers/soundcloud"
 ],
 "authorization_url": "https://secure.soundcloud.com/authorize",
 "token_url": "https://secure.soundcloud.com/oauth/token",
 "profile_url": "https://api.soundcloud.com/me",
 "token_auth": "client_secret_post",
 "pkce": "S256",
 "base_scopes": [],
 "flags": [],
 "freeform_scopes": false,
 "free_scope": true,
 "profile": {
  "user_id": "id",
  "name": "full_name",
  "nickname": "username",
  "picture": "avatar_url"
 },
 "email_verified": {
  "rule": "never"
 },
 "profile_auth": "scheme:OAuth"
}
