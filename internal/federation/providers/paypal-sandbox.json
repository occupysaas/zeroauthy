{
 "strategy": "paypal-sandbox",
 "display_name": "PayPal Sandbox",
 "source": [
  "https://developer.paypal.com/docs/log-in-with-paypal/integrate/",
  "https://developer.paypal.com/docs/api/identity/v1/",
  "https://auth0.com/docs/authenticate/identity-providers/social-identity-providers/paypal"
 ],
 "authorization_url": "https://www.sandbox.paypal.com/signin/authorize",
 "token_url": "https://api-m.sandbox.paypal.com/v1/oauth2/token",
 "profile_url": "https://api-m.sandbox.paypal.com/v1/identity/oauth2/userinfo?schema=paypalv1.1",
 "token_auth": "client_secret_basic",
 "pkce": "none",
 "base_scopes": [
  "openid"
 ],
 "flags": [
  {
   "option": "profile",
   "scopes": [
    "profile"
   ]
  },
  {
   "option": "email",
   "scopes": [
    "email"
   ]
  },
  {
   "option": "address",
   "scopes": [
    "address"
   ]
  },
  {
   "option": "phone",
   "scopes": [
    "phone"
   ]
  }
 ],
 "freeform_scopes": true,
 "profile": {
  "user_id": "user_id",
  "email": "emails[?primary].value",
  "name": "name",
  "given_name": "given_name",
  "family_name": "family_name",
  "provider_data": [
   "payer_id"
  ]
 },
 "email_verified": {
  "rule": "field",
  "path": "emails[?primary].confirmed"
 }
}
