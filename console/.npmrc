# Don't run dependencies' install scripts (preinstall, install, postinstall).
# None is needed here: vue-demi's only switches between its Vue 2 and Vue 3
# builds (it ships the Vue 3 one), and fsevents' only rebuilds the macOS
# binary it already ships. If a dependency ever needs its script, run
# `npm rebuild <package> --ignore-scripts=false` after installing.
ignore-scripts=true
