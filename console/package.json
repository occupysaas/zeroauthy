{
  "name": "zeroauthy-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "gen": "openapi-typescript ../api/management.yaml -o src/api/schema.d.ts",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "build": "vite build"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "pinia": "3.0.4",
    "reka-ui": "2.10.5",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-i18n": "11.4.16",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "happy-dom": "20.14.5",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.12"
  }
}
