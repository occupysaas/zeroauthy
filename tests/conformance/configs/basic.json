{
    "description": "zeroauthy: OpenID Connect Basic OP",
    "server": {
        "discoveryUrl": "https://zeroauthy.conformance.test:8443/.well-known/openid-configuration"
    },
    "client": {
        "client_id": "za-conformance-1",
        "client_secret": "za-conformance-1-secret-not-for-production"
    },
    "client2": {
        "client_id": "za-conformance-2",
        "client_secret": "za-conformance-2-secret-not-for-production"
    },
    "alias": "zeroauthy",
    "client_secret_post": {
        "client_id": "za-conformance-post",
        "client_secret": "za-conformance-post-secret-not-for-production"
    },
    "browser": [
        {
            "match": "https://zeroauthy.conformance.test:8443/authorize*",
            "tasks": [
                {
                    "task": "Login",
                    "optional": true,
                    "match": "*/u/login*",
                    "commands": [
                        [
                            "text",
                            "id",
                            "username",
                            "conformance@example.com"
                        ],
                        [
                            "text",
                            "id",
                            "password",
                            "Conformance-Horse-9"
                        ],
                        [
                            "click",
                            "css",
                            "button[type=submit]"
                        ]
                    ]
                },
                {
                    "task": "Consent",
                    "optional": true,
                    "match": "*/u/consent*",
                    "commands": [
                        [
                            "click",
                            "css",
                            "button[name=action][value=accept]"
                        ]
                    ]
                },
                {
                    "task": "Verify Complete",
                    "match": "*/test/*/callback*",
                    "commands": [
                        [
                            "wait",
                            "id",
                            "submission_complete",
                            10
                        ]
                    ]
                }
            ]
        }
    ],
    "override": {
        "oidcc-ensure-registered-redirect-uri": {
            "browser": [
                {
                    "comment": "expect an error page",
                    "match": "https://zeroauthy.conformance.test:8443/authorize*",
                    "tasks": [
                        {
                            "task": "Expect error page",
                            "match": "https://zeroauthy.conformance.test:8443/authorize*",
                            "commands": [
                                [
                                    "wait",
                                    "xpath",
                                    "//*[@role='alert']",
                                    10,
                                    ".",
                                    "update-image-placeholder"
                                ]
                            ]
                        }
                    ]
                }
            ]
        },
        "oidcc-ensure-request-object-with-redirect-uri": {
            "browser": [
                {
                    "comment": "expect an error page",
                    "match": "https://zeroauthy.conformance.test:8443/authorize*",
                    "tasks": [
