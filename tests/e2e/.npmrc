# Don't run dependencies' install scripts (preinstall, install, postinstall).
# None is needed here: esbuild's only checks the platform binary it gets as
# an optional dependency, and browser-tabs-lock's only prints a message.
# Playwright's browsers are installed explicitly (`npx playwright install`).
# If a dependency ever needs its script, run
# `npm rebuild <package> --ignore-scripts=false` after installing.
ignore-scripts=true
